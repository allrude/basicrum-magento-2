<?php
declare(strict_types=1);

use BasicRum\Analytics\ViewModel\Footer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var SecureHtmlRenderer $secureRenderer */

/** @var Footer $viewModel */
$viewModel = $block->getViewModel();
$beaconUrl = $viewModel->getBeaconUrl();

// Without a beacon endpoint there is nothing to send to — skip rendering entirely.
if ($beaconUrl === '') {
    return;
}

$pageType = $escaper->escapeJs($viewModel->getPageType());
$beaconUrl = $escaper->escapeJs($beaconUrl);
$boomerangSrc = $escaper->escapeJs($block->getViewFileUrl(\BasicRum\Analytics\Model\Boomerang::JS_VIEW_PATH));

$scriptString = <<<script
(function (w, d) {
    if (!w) {
        return;
    }

    var WAIT_AFTER_ONLOAD_MILLISECONDS = 5000;

    // Boomerang method queue: calls pushed here are replayed once the library has loaded.
    w.BOOMR_mq = w.BOOMR_mq || [];
    w.BOOMR_mq.push(
        ["init", {
            beacon_url: "{$beaconUrl}",
            // We finalize the beacon manually (see BOOMR.page_ready below) to capture late activity.
            autorun: false,
            instrument_xhr: true,
            Continuity: { enabled: true },
            ResourceTiming: { enabled: true, splitAtPath: true },
            secure_cookie: true,
            same_site_cookie: "Strict"
        }],
        ["addVar", "p_type", "{$pageType}"],
        ["addVar", "p_gen", "mage2"]
    );

    // Finalize (and send) the beacon a fixed delay after the page has fully loaded.
    function scheduleBeacon() {
        w.setTimeout(function () {
            if (w.BOOMR && typeof w.BOOMR.page_ready === "function") {
                w.BOOMR.page_ready();
            }
        }, WAIT_AFTER_ONLOAD_MILLISECONDS);
    }

    if (d.readyState === "complete") {
        scheduleBeacon();
    } else {
        w.addEventListener("load", scheduleBeacon);
    }

    // Asynchronously load the Boomerang library.
    (function () {
        var js = d.createElement("script"),
            first = d.getElementsByTagName("script")[0];

        js.async = true;
        js.src = "{$boomerangSrc}";
        first.parentNode.insertBefore(js, first);
    })();
})(window, document);
script;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false) ?>
